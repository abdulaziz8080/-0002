generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// مكتب محاسبة / معقّب — حساب واحد لكل مكتب، وله جلسة واتساب خاصة
model Office {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  /// أرقام الواتساب التي تصلها تنبيهات المكتب (مفصولة بفاصلة)، بصيغة دولية 9665XXXXXXXX
  alertPhones  String   @default("")
  /// إرسال نسخة من التنبيه لجوال مسؤول المنشأة (إن وُجد)
  notifyOrgContacts Boolean @default(false)
  contactPhone String   @default("")
  contactEmail String   @default("")
  timezone     String   @default("Asia/Riyadh")
  logoDataUrl  String?
  /// office | admin — مدير الموقع يدخل من نفس الصفحة ويُحوَّل للوحة الإدارة
  role         String   @default("office")
  /// trial | basic | pro
  plan         String   @default("trial")
  /// active | suspended
  status       String   @default("active")
  planExpiresAt DateTime?
  adminNote    String   @default("")
  createdAt    DateTime @default(now())

  orgs      Org[]
  reminders ReminderLog[]
  waSession WhatsappSession?
  tickets   SupportTicket[]
}

/// بلاغ/طلب دعم من مكتب إلى إدارة الموقع
model SupportTicket {
  id        String   @id @default(cuid())
  officeId  String
  office    Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  /// issue | billing | question
  type      String   @default("issue")
  subject   String
  body      String
  /// open | answered | closed
  status    String   @default("open")
  reply     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officeId])
  @@index([status])
}

/// إعدادات عامة للموقع يحرّرها المدير (أرقام خدمة العملاء…)
model SiteSettings {
  id            Int    @id @default(1)
  supportPhone  String @default("")
  supportWhatsapp String @default("")
  supportEmail  String @default("")
  supportHours  String @default("")
  announcement  String @default("")
}

/// منشأة يديرها المكتب
model Org {
  id           String   @id @default(cuid())
  officeId     String
  office       Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name         String
  crNumber     String   @default("")
  city         String   @default("")
  contactName  String   @default("")
  contactPhone String   @default("")
  contactEmail String   @default("")
  alertPhones  String   @default("")
  notifyEnabled Boolean @default(true)
  createdAt    DateTime @default(now())

  items Item[]

  @@index([officeId])
}

/// التزام نظامي لمنشأة
model Item {
  id            String   @id @default(cuid())
  orgId         String
  org           Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templateId    String
  name          String
  authority     String
  category      String
  /// YYYY-MM-DD
  dueDate       String
  leadDays      Int
  cycleDays     Int
  estimatedCost Int      @default(0)
  reference     String   @default("")
  note          String   @default("")
  done          Boolean  @default(false)
  createdAt     DateTime @default(now())

  renewals  Renewal[]
  reminders ReminderLog[]

  @@index([orgId])
}

model Renewal {
  id          String   @id @default(cuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  previousDue String
  newDue      String
  createdAt   DateTime @default(now())

  @@index([itemId])
}

/// حالة جلسة واتساب المكتب (بيانات الاعتماد نفسها تُحفظ على القرص)
model WhatsappSession {
  officeId    String   @id
  office      Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  status      String   @default("disconnected")
  phone       String?
  connectedAt DateTime?
  updatedAt   DateTime @updatedAt
}

/// سجل التذكيرات المرسلة — يمنع تكرار نفس التذكير لنفس البند
model ReminderLog {
  id        String   @id @default(cuid())
  officeId  String
  office    Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  itemId    String?
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  /// مثل: lead | d30 | d14 | d7 | d0 | overdue:2026-09-08
  milestone String
  to        String
  message   String
  status    String   @default("sent")
  error     String?
  sentAt    DateTime @default(now())

  @@unique([itemId, milestone, to])
  @@index([officeId, sentAt])
}
