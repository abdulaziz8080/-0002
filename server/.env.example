DATABASE_URL="file:./data/multazim.db"
# إلزامي في الإنتاج: 32 حرفاً عشوائياً على الأقل — ولّده بـ: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"
# NODE_ENV=production
# فعّله (1) فقط إذا كان الخادم خلف Nginx/موزّع حمل يرسل X-Forwarded-For
# TRUST_PROXY=0
PORT=4000
# مواعيد الفحص اليومي (cron) بتوقيت TZ
REMINDER_CRON="0 8 * * *"
TZ="Asia/Riyadh"
# مجلد حفظ جلسات واتساب
WA_AUTH_DIR="./data/wa"
# حساب مدير الموقع: يُنشأ تلقائياً عند أول تشغيل إن لم يوجد، ويدخل من صفحة الدخول نفسها
ADMIN_EMAIL="admin@example.com"
# تُستخدم مرة واحدة عند الإنشاء فقط — غيّرها بعد أول دخول من الإعدادات
ADMIN_PASSWORD="change-me-8-chars-min"
# أصول الواجهة المسموح لها (CORS)
CORS_ORIGIN="http://localhost:3000"
